rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'streak', 'isPro', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.streak is number &&
             data.isPro is bool &&
             data.createdAt == request.time;
    }

    function isValidHistory(data) {
      return data.keys().hasAll(['userId', 'word', 'transcript', 'clarity', 'accuracy', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.createdAt == request.time;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      
      match /practice_history/{historyId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidHistory(incoming());
      }
    }
  }
}
