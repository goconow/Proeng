rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'streak', 'isPro', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.streak is number &&
             data.isPro is bool &&
             data.createdAt == request.time;
    }

    function isValidHistory(data) {
      return data.keys().hasAll(['userId', 'word', 'transcript', 'clarity', 'accuracy', 'feedback', 'createdAt']) &&
             data.keys().size() <= 9 &&
             data.userId == request.auth.uid &&
             data.word is string && data.word.size() <= 100 &&
             data.transcript is string && data.transcript.size() <= 2000 &&
             data.clarity is number && data.clarity >= 0 && data.clarity <= 100 &&
             data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100 &&
             data.feedback is string && data.feedback.size() <= 5000 &&
             data.createdAt == request.time;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      // No list for users
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      
      allow update: if isOwner(userId) && (
        // Action: Update Stats
        (incoming().diff(existing()).affectedKeys().hasOnly(['streak', 'lastActive']) &&
         incoming().streak is number &&
         incoming().lastActive is string)
      );
      
      match /practice_history/{historyId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        
        allow create: if isOwner(userId) && isValidId(historyId) && isValidHistory(incoming());
        // History items are immutable
      }
    }
  }
}
